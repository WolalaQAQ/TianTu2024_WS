<launch>
  <!--<master auto="start"/>-->
  
  <!--<node name="odom" pkg="rm_ep" type="rm_ep_odom_test"/> -->

  <include file="$(find lslidar_x10_driver)/launch/lslidar_x10_serial.launch" />
    
  <!-- Run the slam gmapping -->
  <include file="$(find rm_ep)/launch/slam_gmapping.launch"/>

    <!-- Publish static tf -->
  <!--<include file="$(find rm_ep)/launch/static_tf.launch" /> -->
  
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find mrobot_navigation)/rviz/gmapping.rviz"/>
  
  <include file="$(find rm_ep)/launch/car.launch" />

  </launch>
