<?xml version="1.0"?>
<launch>
  <!-- Example Image Publisher -->
  <node pkg="yolo_detector" type="example_image_publisher" name="example_image_publisher" output="screen">
    <remap from="image_raw" to="/camera/image_raw"/>

    <!-- is_video 参数为0时读入图片 参数为1时读入视频-->
    <param name="is_video" type="int" value="0"/>
    <param name="path" value="/media/wolala/NTFS1/TianTuDataset/total_dataset/images/20240504_221929_56.png"/>
  </node>

</launch>