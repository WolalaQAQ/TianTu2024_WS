<?xml version="1.0"?>
<launch>
  <!-- YOLO Detector -->
  <node pkg="yolo_detector" type="yolo_detector_node" name="yolo_detector" output="screen">
    <remap from="image_raw" to="/camera/image_raw"/>

    <remap from="image_marked" to="/yolo_detector/image_marked"/>
    <remap from="image_filtered" to="/yolo_detector/image_filtered"/>

    <remap from="detect_info" to="/yolo_detector/detect_info"/>

    <param name="model_path" value="/home/tta/TianTu2024_WS/src/yolo_detector/model/2024-7-20.onnx"/>

    <param name="save_marker_image" type="bool" value="true"/>
    <param name="save_image_path" value="/home/tta/TianTu2024_WS/images"/>
  </node>

</launch>